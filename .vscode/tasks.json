{
    // 「ターミナル → タスクの実行」から選べる、研修用のボタン集。
    "version": "2.0.0",
    "tasks": [
        {
            // きょうの成果を先生に見せる（＝自分のブランチへ送る）。中身は training/send.sh。
            "label": "📤 成果を送信（先生に見せる）",
            "type": "shell",
            "command": "bash training/send.sh",
            "problemMatcher": [],
            "presentation": {
                "reveal": "always",
                "panel": "shared",
                "focus": true,
                "clear": true
            },
            "detail": "きょう書いたぶんを、先生が見られる場所へ送ります（提出でも採点でもありません）。"
        },
        {
            // 先生が直した教材を、自分の手元に取り込む。中身は training/update.sh。
            // 「送信」が あなた→先生 の向きなら、こちらは 先生→あなた の向き。
            "label": "📥 教材を更新（先生の直しを取り込む）",
            "type": "shell",
            "command": "bash training/update.sh",
            "problemMatcher": [],
            "presentation": {
                "reveal": "always",
                "panel": "shared",
                "focus": true,
                "clear": true
            },
            "detail": "先生が直した教材（説明の追加・課題の改善）を、あなたの手元に取り込みます。"
        }
    ]
}
