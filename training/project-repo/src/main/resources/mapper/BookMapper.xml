<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">

<!--
  books テーブルへのSQLを書くファイル。
  namespace は対応する Mapper インタフェースの完全名（パッケージ込み）。
  各 <select> の id は、インタフェースのメソッド名と一致させる。
-->
<mapper namespace="com.example.training.book.BookMapper">

    <!--
      列名(snake_case)と Javaフィールド(camelCase)の対応。
      application.yml で map-underscore-to-camel-case を有効にしているため
      ほとんど自動だが、明示しておくと読み手に親切。
    -->
    <resultMap id="bookResultMap" type="com.example.training.book.Book">
        <id     property="id"             column="id"/>
        <result property="title"          column="title"/>
        <result property="author"         column="author"/>
        <result property="category"       column="category"/>
        <result property="totalCount"     column="total_count"/>
        <result property="availableCount" column="available_count"/>
        <result property="createdAt"      column="created_at"/>
    </resultMap>

    <!--
      一覧取得。category が渡されたときだけ WHERE で絞る。
      <if> で「引数が null でなければ条件を足す」動的SQL。
    -->
    <select id="findAll" resultMap="bookResultMap">
        SELECT id, title, author, category, total_count, available_count, created_at
        FROM books
        <if test="category != null">
            WHERE category = #{category}
        </if>
        ORDER BY id
    </select>

    <select id="findById" resultMap="bookResultMap">
        SELECT id, title, author, category, total_count, available_count, created_at
        FROM books
        WHERE id = #{id}
    </select>

    <!--
      貸出可能数を1減らす。WHERE に available_count > 0 を入れることで、
      在庫が残っているときだけ減る。もし0なら1行も更新されず、
      呼び出し側（Service）が返り値0を見て「在庫切れ」と判断できる。
      条件をSQL側に持たせることで、2件同時の貸出でも最後の1冊を
      二重に貸してしまう事故を防いでいる（DB側での安全弁）。
    -->
    <update id="decrementAvailable">
        UPDATE books
        SET available_count = available_count - 1
        WHERE id = #{id}
          AND available_count > 0
    </update>

    <!--
      貸出可能数を1増やす（返却時）。total_count を超えて増えないよう
      WHERE で歯止めをかけている。整合が保たれていれば必ず1行更新される。
    -->
    <update id="incrementAvailable">
        UPDATE books
        SET available_count = available_count + 1
        WHERE id = #{id}
          AND available_count &lt; total_count
    </update>

</mapper>
