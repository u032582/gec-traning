<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">

<!--
  members テーブルへのSQLを書くファイル。
  namespace は対応する Mapper インタフェースの完全名（パッケージ込み）。
-->
<mapper namespace="com.example.training.member.MemberMapper">

    <resultMap id="memberResultMap" type="com.example.training.member.Member">
        <id     property="id"        column="id"/>
        <result property="name"      column="name"/>
        <result property="email"     column="email"/>
        <result property="createdAt" column="created_at"/>
    </resultMap>

    <select id="findById" resultMap="memberResultMap">
        SELECT id, name, email, created_at
        FROM members
        WHERE id = #{id}
    </select>

</mapper>
